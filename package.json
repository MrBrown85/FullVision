{
  "name": "teacher-dashboard",
  "version": "1.0.0",
  "description": "Standards-based gradebook for BC teachers",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:e2e": "bash scripts/build-e2e.sh",
    "dev": "npx serve -l 8347",
    "dev:local": "node scripts/dev-local.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:real": "npx playwright test --config=playwright.real.config.js",
    "test:e2e:real:race": "npx playwright test --config=playwright.real.config.js -g \"race-immediate-signOut\"",
    "test:e2e:real:headed": "npx playwright test --config=playwright.real.config.js --headed",
    "format": "prettier --write '**/*.{js,css,html,json,md}'",
    "format:check": "prettier --check '**/*.{js,css,html,json,md}'",
    "format:staged": "bash scripts/format-staged.sh",
    "audit:html": "node scripts/audit-innerhtml.mjs --check",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.2.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}

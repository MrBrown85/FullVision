{
  "format": 1,
  "about": "Worked cases for the Draft and Returned rule (docs/plans/student-page-build-plan.md 1.2). One file, run through the SQL triggers (migrations/local-test/grade_return.py) and through shared/grade-state.js, so the two cannot drift.",
  "how_to_read": {
    "class": "The class settings the case starts with: student_page (course.student_page_enabled) and return_grades (on_return, on_save or null for no choice made).",
    "work": "What kind of assessment one student is graded on: competencies (levels on t1 and t2), rubric (criteria c1 and c2, with checkbox k1 on c1 and k2 on c2), or points (one score).",
    "steps": "In order. A step with \"do\" is something that happens; a step with \"expect\" is what must be true at that point.",
    "do": {
      "level": "A competency level: tag, value (0 clears it), and optionally modifier and comment.",
      "criterion": "A criterion level: criterion, value (0 clears it), and optionally modifier, comment and beyond. A comment or beyond left out keeps the saved one.",
      "score": "Points, a mark or an Overall level: value, and optionally modifier.",
      "tick": "An Advanced Rubric checkbox: check, on.",
      "comment": "The Overall Comment: text.",
      "note": "The Note for the Report: text.",
      "status": "Missing (NS), Excused (EXC), Late (LATE) or null to take it off.",
      "clear": "Clear Score.",
      "return": "The teacher returns this grade.",
      "seen": "The student opens this piece.",
      "class": "The class settings change: student_page, return_grades."
    },
    "expect": {
      "state": "draft: the working copy holds something the student has not been given. returned: nothing is waiting and the student has a grade. none: no grade is returned and none is waiting.",
      "student": "The grade the student is given, as a copy, or null for nothing. A draft is never in it.",
      "status": "The status the student sees. It is never a draft.",
      "previous": "The grade the student had before the newest return, as a copy, or null.",
      "updated": "True when the student page marks the grade Updated."
    },
    "copy": "A grade as JSON: v (always 1), value, modifier and comment from the score row (the Overall level, points or mark, its + or -, and the Overall Comment), tags (competency id to value, modifier, comment), criteria (criterion id to value, modifier, comment, beyond) and checks (ticked checkbox ids, sorted). A blank comment is null. A grade with nothing in it is null, not an empty copy."
  },
  "cases": [
    {
      "name": "A new grade is a draft until it is returned",
      "class": {
        "student_page": true,
        "return_grades": "on_return"
      },
      "work": "competencies",
      "steps": [
        {
          "do": "level",
          "tag": "t1",
          "value": 3
        },
        {
          "expect": {
            "state": "draft",
            "student": null,
            "status": null,
            "previous": null,
            "updated": false
          }
        },
        {
          "do": "return"
        },
        {
          "expect": {
            "state": "returned",
            "student": {
              "v": 1,
              "value": null,
              "modifier": 0,
              "comment": null,
              "tags": {
                "t1": {
                  "value": 3,
                  "modifier": 0,
                  "comment": null
                }
              },
              "criteria": {},
              "checks": []
            },
            "status": null,
            "previous": null,
            "updated": false
          }
        }
      ]
    },
